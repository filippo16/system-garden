# ==========================================
# CONFIGURAZIONE SERVIZIO TELEGRAM & MQTT VPS
# ==========================================

# 1. Telegram Bot Settings
# Ottieni il token parlando con @BotFather su Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Whitelist degli ID utente Telegram autorizzati ad usare il bot (separati da virgola)
# Ottieni il tuo ID scrivendo a @userinfobot su Telegram
ALLOWED_USER_IDS=478034542

# 2. HiveMQ Cloud MQTT Settings (TLS 8883)
MQTT_HOST=288ea69720d64b498ef73c73d5c405a5.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=ESP-8266
MQTT_PASS=c'R6:V`|';a:467,%sc5=6i|NR
MQTT_CLIENT_ID=oracle-vps-bot

# 3. MQTT Topics (devono corrispondere a MQTT_COMMANDS.md)
MQTT_TOPIC_COMMAND=command
MQTT_TOPIC_INFO=info
MQTT_TOPIC_LOG=log

# 4. Dead Man's Switch / Watchdog
# Minuti di inattività massima prima di inviare un allarme di centralina offline
HEARTBEAT_TIMEOUT_MINUTES=15
